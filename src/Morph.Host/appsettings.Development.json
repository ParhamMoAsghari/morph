{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Morph": {
    "ConnectionStrings": {
      "Platform": "Host=localhost;Port=5432;Database=morph;Username=morph;Password=morph"
    },
    "Redis": {
      "ConnectionString": "localhost:6379"
    },
    "Auth": {
      "Issuer": "http://localhost:5100/",
      "PlatformClientSecret": "morph-platform-dev-secret"
    },
    "ObjectStorage": {
      "Endpoint": "http://localhost:9000",
      "AccessKey": "morphminio",
      "SecretKey": "morphminio",
      "BucketPrefix": "morph",
      "ForcePathStyle": true,
      "Region": "us-east-1"
    },
    "Mail": {
      "SmtpHost": "localhost",
      "SmtpPort": 1025,
      "From": "noreply@morph.local",
      "FromDisplayName": "Morph",
      "PublicBaseUrl": "http://localhost:5100"
    },
    "Hangfire": {
      "SchemaName": "hangfire"
    },
    "Quotas": {
      "MaxEnvironmentsPerProject": 10,
      "MaxDefinitionsPerEnvironment": 200,
      "MaxApiRequestsPerDay": 100000,
      "MaxWebhookSubscriptionsPerProject": 50,
      "MaxStorageBytesPerProject": 5368709120
    }
  }
}
