{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenIddict": "Information"
      }
    }
  },
  "Morph": {
    "ConnectionStrings": {
      "Platform": ""
    },
    "Redis": {
      "ConnectionString": ""
    },
    "Auth": {
      "Issuer": "https://localhost:5101/"
    },
    "ObjectStorage": {
      "Endpoint": "http://localhost:9000",
      "AccessKey": "morphminio",
      "SecretKey": "morphminio",
      "BucketPrefix": "morph",
      "ForcePathStyle": true
    },
    "Mail": {
      "SmtpHost": "localhost",
      "SmtpPort": 1025,
      "From": "noreply@morph.local"
    }
  },
  "Plugins": {
    "Path": "./plugins",
    "EnableAllDiscovered": true
  },
  "AllowedHosts": "*"
}
