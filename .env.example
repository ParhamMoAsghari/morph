# Copy to .env for Docker Compose / local overrides. Do not commit real secrets.

MORPH_ConnectionStrings__Platform=Host=postgres;Port=5432;Database=morph;Username=morph;Password=morph
MORPH_Redis__ConnectionString=redis:6379
MORPH_ObjectStorage__Endpoint=http://minio:9000
MORPH_ObjectStorage__AccessKey=morphminio
MORPH_ObjectStorage__SecretKey=morphminio
MORPH_ObjectStorage__BucketPrefix=morph
MORPH_ObjectStorage__ForcePathStyle=true
MORPH_Mail__SmtpHost=mailpit
MORPH_Mail__SmtpPort=1025
MORPH_Mail__From=noreply@morph.local
MORPH_Auth__Issuer=http://localhost:5100/
MORPH_Auth__PlatformClientSecret=morph-platform-dev-secret

POSTGRES_USER=morph
POSTGRES_PASSWORD=morph
POSTGRES_DB=morph
MINIO_ROOT_USER=morphminio
MINIO_ROOT_PASSWORD=morphminio
